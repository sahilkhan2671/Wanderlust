<% layout("/layouts/boilerplate") %>

<script>
  const mapToken = <%- JSON.stringify(process.env.MAP_TOKEN || "") %>;
  const listing = <%- JSON.stringify(listing) %>;
</script>

<style>
  .show-page {
    max-width: 1120px;
    margin: 30px auto 65px;
    padding: 0 24px;
    color: #222;
  }

  /* Header */
  .property-header {
    margin-bottom: 20px;
  }

  .property-header h1 {
    font-size: clamp(1.6rem, 2.7vw, 2.15rem);
    font-weight: 700;
    letter-spacing: -0.6px;
    overflow-wrap: anywhere;
    margin-bottom: 9px;
  }

  .property-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    align-items: center;
    font-size: 14px;
    color: #646464;
  }

  .property-meta a {
    color: #222;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Main two-column layout */
  .property-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(280px, 0.8fr);
    gap: 34px;
    align-items: start;
  }

  .property-main {
    min-width: 0;
  }

  /* Medium, balanced property image */
  .property-image-wrap {
    width: 100%;
    height: clamp(240px, 30vw, 340px);
    overflow: hidden;
    border-radius: 13px;
    background: #f3f3f3;
    margin-bottom: 23px;
  }

  .property-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .property-image:hover {
    transform: scale(1.02);
  }

  /* Host information */
  .host-block {
    display: flex;
    align-items: center;
    gap: 13px;
    padding-bottom: 20px;
    border-bottom: 1px solid #e8e8e8;
  }

  .host-avatar {
    width: 46px;
    height: 46px;
    flex: 0 0 46px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f5f5f5;
    border-radius: 50%;
    font-size: 19px;
    color: #444;
  }

  .host-block h2 {
    font-size: 16px;
    font-weight: 700;
    margin: 0 0 5px;
  }

  .host-block p {
    color: #717171;
    font-size: 13px;
    margin: 0;
  }

  .property-description {
    padding: 21px 0;
    border-bottom: 1px solid #e8e8e8;
    font-size: 14px;
    line-height: 1.85;
    color: #555;
    white-space: pre-line;
    overflow-wrap: anywhere;
  }

  .property-facts {
    padding-top: 8px;
  }

  .fact-row {
    display: flex;
    gap: 14px;
    padding: 17px 0;
    border-bottom: 1px solid #eee;
  }

  .fact-icon {
    width: 25px;
    flex: 0 0 25px;
    font-size: 19px;
    text-align: center;
    color: #333;
  }

  .fact-row h3 {
    font-size: 14px;
    font-weight: 650;
    margin: 0 0 5px;
  }

  .fact-row p {
    color: #717171;
    font-size: 13px;
    margin: 0;
    overflow-wrap: anywhere;
  }

  /* Price and owner actions */
  .property-sidebar {
    position: sticky;
    top: 24px;
    border: 1px solid #dedede;
    border-radius: 13px;
    padding: 23px;
    background: #fff;
  }

  .price-heading {
    font-size: 25px;
    font-weight: 750;
    letter-spacing: -0.6px;
  }

  .price-heading small {
    font-size: 14px;
    color: #717171;
    font-weight: 400;
    letter-spacing: 0;
  }

  .sidebar-divider {
    border: 0;
    border-top: 1px solid #e9e9e9;
    margin: 19px 0;
  }

  .sidebar-note {
    display: flex;
    gap: 10px;
    font-size: 13px;
    line-height: 1.7;
    color: #626262;
  }

  .sidebar-note i {
    margin-top: 3px;
    color: #444;
  }

  .owner-actions {
    display: grid;
    gap: 10px;
  }

  .owner-actions .btn {
    width: 100%;
    min-height: 43px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
  }

  .edit-button {
    background: #222;
    color: #fff;
    border: 1px solid #222;
  }

  .edit-button:hover {
    background: #444;
    color: #fff;
  }

  /* Sections */
  .content-section {
    margin-top: 43px;
    scroll-margin-top: 25px;
  }

  .section-heading {
    font-size: 23px;
    font-weight: 700;
    letter-spacing: -0.4px;
    margin-bottom: 8px;
  }

  .section-description {
    font-size: 13px;
    color: #717171;
    margin-bottom: 20px;
  }

  /* Review form */
  .review-form {
    max-width: 650px;
    padding: 23px;
    border: 1px solid #e5e5e5;
    border-radius: 12px;
    background: #fff;
  }

  .review-form .form-label {
    display: block;
    font-size: 14px;
    font-weight: 650;
    margin-bottom: 10px;
  }

  .review-form .form-control {
    border: 1px solid #ccc;
    border-radius: 8px;
    padding: 12px;
    font-size: 14px;
  }

  .review-form .form-control:focus {
    border-color: #222;
    box-shadow: 0 0 0 2px rgba(34, 34, 34, 0.1);
  }

  .submit-review {
    background: #222;
    color: #fff;
    border: 1px solid #222;
    border-radius: 8px;
    padding: 11px 18px;
    font-size: 14px;
    font-weight: 600;
  }

  .submit-review:hover {
    background: #444;
    color: #fff;
  }

  /* FIX: keep rating stars in one horizontal row */
  .review-form fieldset.starability-slot {
    display: flex !important;
    flex-flow: row nowrap !important;
    align-items: center;
    justify-content: flex-start;
    gap: 3px;
    width: max-content;
    max-width: 100%;
    min-height: 40px;
    padding: 0;
    margin: 0;
    border: 0;
    overflow: visible;
  }

  .review-form fieldset.starability-slot input {
    flex: 0 0 auto;
  }

  .review-form fieldset.starability-slot label {
    flex: 0 0 30px;
    width: 30px;
    max-width: 30px;
    margin: 0;
    padding: 0;
    display: inline-block;
    white-space: nowrap;
  }

  /* Reviews */
  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 30px;
  }

  .review-card {
    min-width: 0;
    padding: 19px 0;
    border-top: 1px solid #e7e7e7;
    overflow-wrap: anywhere;
  }

  .review-user {
    display: flex;
    align-items: center;
    gap: 11px;
    margin-bottom: 12px;
  }

  .review-user-icon {
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f3f3f3;
    border-radius: 50%;
    font-size: 17px;
  }

  .review-user h3 {
    font-size: 14px;
    font-weight: 650;
    margin: 0 0 4px;
  }

  .review-user span {
    font-size: 12px;
    color: #777;
  }

  .review-card .starability-result {
    margin-bottom: 10px;
  }

  .review-comment {
    color: #555;
    font-size: 14px;
    line-height: 1.8;
    white-space: pre-line;
    margin-bottom: 12px;
  }

  .review-delete {
    border-radius: 7px;
    font-size: 12px;
  }

  .empty-reviews {
    border-top: 1px solid #e7e7e7;
    padding: 23px 0;
  }

  .empty-reviews h3 {
    font-size: 16px;
    font-weight: 650;
    margin-bottom: 6px;
  }

  .empty-reviews p {
    color: #717171;
    font-size: 14px;
    margin: 0;
  }

  /* Map */
  #map {
    width: 100%;
    height: 330px;
    border-radius: 12px;
    border: 1px solid #e3e3e3;
    background: #f4f4f4;
    overflow: hidden;
  }

  .map-message {
    margin-top: 9px;
    font-size: 13px;
    color: #717171;
  }

  /* Tablet and mobile */
  @media (max-width: 760px) {
    .show-page {
      padding: 0 18px;
      margin-top: 23px;
    }

    .property-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 25px;
    }

    .property-image-wrap {
      height: clamp(230px, 55vw, 330px);
    }

    .property-sidebar {
      position: static;
    }

    .reviews-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .content-section {
      margin-top: 36px;
    }

    #map {
      height: 290px;
    }
  }

  @media (max-width: 420px) {
    .show-page {
      padding: 0 13px;
    }

    .property-header h1 {
      font-size: 1.55rem;
    }

    .property-image-wrap {
      height: 225px;
      border-radius: 10px;
    }

    .property-sidebar,
    .review-form {
      padding: 18px;
    }

    .section-heading {
      font-size: 21px;
    }

    .property-meta {
      font-size: 13px;
    }
  }
</style>

<div class="show-page">

  <!-- Property heading -->
  <header class="property-header">
    <h1><%= listing.title %></h1>

    <div class="property-meta">
      <span>
        <i class="fa-solid fa-location-dot"></i>
        <%= listing.location %>, <%= listing.country %>
      </span>

      <a href="#location-map">Show map</a>
    </div>
  </header>

  <!-- Two-column property layout -->
  <div class="property-layout">

    <main class="property-main">

      <div class="property-image-wrap">
        <img
          src="<%= listing.image.url %>"
          class="property-image"
          alt="<%= listing.title %>"
        >
      </div>

      <div class="host-block">
        <div class="host-avatar">
          <i class="fa-regular fa-user"></i>
        </div>

        <div>
          <h2><%= listing.title %></h2>
          <p>Hosted by <strong><%= listing.owner.username %></strong></p>
        </div>
      </div>

      <div class="property-description"><%= listing.description %></div>

      <div class="property-facts">

        <div class="fact-row">
          <div class="fact-icon">
            <i class="fa-solid fa-house"></i>
          </div>
          <div>
            <h3>About this place</h3>
            <p>Explore the property and its surroundings.</p>
          </div>
        </div>

        <div class="fact-row">
          <div class="fact-icon">
            <i class="fa-solid fa-location-dot"></i>
          </div>
          <div>
            <h3>Location</h3>
            <p><%= listing.location %></p>
          </div>
        </div>

        <div class="fact-row">
          <div class="fact-icon">
            <i class="fa-solid fa-earth-asia"></i>
          </div>
          <div>
            <h3>Country</h3>
            <p><%= listing.country %></p>
          </div>
        </div>

      </div>

    </main>

    <!-- Price and owner controls -->
    <aside class="property-sidebar">

      <div class="price-heading">
        &#8377;<%= Number(listing.price).toLocaleString("en-IN") %>
        <small>/ night</small>
      </div>

      <hr class="sidebar-divider">

      <div class="sidebar-note">
        <i class="fa-solid fa-circle-info"></i>
        <span>
          Check the property details, location and guest reviews
          before planning your stay.
        </span>
      </div>

      <% if (currUser && listing.owner._id.equals(currUser._id)) { %>

        <hr class="sidebar-divider">

        <p class="fw-semibold mb-3">Manage your listing</p>

        <div class="owner-actions">

          <a
            href="/listings/<%= listing._id %>/edit"
            class="btn edit-button"
          >
            <i class="fa-regular fa-pen-to-square me-2"></i>
            Edit listing
          </a>

          <form
            method="POST"
            action="/listings/<%= listing._id %>?_method=DELETE"
            onsubmit="return confirm('Are you sure you want to delete this listing?');"
          >
            <button type="submit" class="btn btn-outline-danger">
              <i class="fa-regular fa-trash-can me-2"></i>
              Delete listing
            </button>
          </form>

        </div>

      <% } %>

    </aside>

  </div>

  <!-- Review form -->
  <% if (currUser) { %>

    <section class="content-section" id="write-review">
      <h2 class="section-heading">Share your experience</h2>
      <p class="section-description">
        Your feedback helps other guests.
      </p>

      <form
        action="/listings/<%= listing._id %>/reviews"
        method="POST"
        novalidate
        class="needs-validation review-form"
      >

        <div class="mb-4">
          <label class="form-label">Rating</label>

          <fieldset class="starability-slot">
            <input
              type="radio"
              id="no-rate"
              class="input-no-rate"
              name="review[rating]"
              value="1"
              checked
              aria-label="No rating"
            >

            <% for (let rating = 1; rating <= 5; rating++) { %>
              <input
                type="radio"
                id="first-rate<%= rating %>"
                name="review[rating]"
                value="<%= rating %>"
              >

              <label
                for="first-rate<%= rating %>"
                title="<%= rating %> star<%= rating > 1 ? 's' : '' %>"
              >
                <%= rating %> star<%= rating > 1 ? 's' : '' %>
              </label>
            <% } %>
          </fieldset>
        </div>

        <div class="mb-4">
          <label for="comment" class="form-label">Your review</label>

          <textarea
            name="review[comment]"
            id="comment"
            rows="4"
            class="form-control"
            placeholder="Share what you liked about this place..."
            minlength="5"
            required
          ></textarea>

          <div class="invalid-feedback">
            Please write a review of at least 5 characters.
          </div>
        </div>

        <button type="submit" class="btn submit-review">
          <i class="fa-regular fa-paper-plane me-2"></i>
          Submit review
        </button>

      </form>
    </section>

  <% } %>

  <!-- Guest reviews -->
  <section class="content-section" id="guest-reviews">

    <h2 class="section-heading">Guest reviews</h2>

    <% if (listing.reviews && listing.reviews.length > 0) { %>

      <div class="reviews-grid">

        <% for (const review of listing.reviews) { %>

          <article class="review-card">

            <div class="review-user">
              <div class="review-user-icon">
                <i class="fa-regular fa-user"></i>
              </div>

              <div>
                <h3><%= review.author.username %></h3>
                <span>Guest review</span>
              </div>
            </div>

            <p
              class="starability-result"
              data-rating="<%= review.rating %>"
            ></p>

            <p class="review-comment"><%= review.comment %></p>

            <% if (
              currUser &&
              review.author &&
              review.author._id.equals(currUser._id)
            ) { %>

              <form
                method="POST"
                action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                onsubmit="return confirm('Delete this review?');"
              >
                <button
                  type="submit"
                  class="btn btn-sm btn-outline-danger review-delete"
                >
                  Delete review
                </button>
              </form>

            <% } %>

          </article>

        <% } %>

      </div>

    <% } else { %>

      <div class="empty-reviews">
        <h3>No reviews yet</h3>
        <p>Be the first to share your experience.</p>
      </div>

    <% } %>

  </section>

  <!-- Location map -->
  <section class="content-section" id="location-map">
    <h2 class="section-heading">Where you'll be</h2>
    <p class="section-description">
      Explore the property's location.
    </p>

    <div id="map"></div>

    <p id="map-message" class="map-message">
      Loading map...
    </p>
  </section>

</div>

<script src="/js/map.js"></script>