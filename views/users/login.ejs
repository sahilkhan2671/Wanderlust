
<% layout("/layouts/boilerplate") %>

<style>
  .login-page {
    min-height: calc(100vh - 100px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 18px;
    background: #fff;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  }

  .login-card {
    width: 100%;
    max-width: 440px;
    padding: 35px;
    border: 1px solid #ebebeb;
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
  }

  .login-brand {
    text-align: center;
    margin-bottom: 25px;
  }

  .login-brand i {
    font-size: 43px;
    color: #ff385c;
  }

  .login-title {
    margin: 0 0 8px;
    color: #222;
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.8px;
  }

  .login-subtitle {
    margin: 0 0 27px;
    color: #717171;
    font-size: 14px;
    line-height: 1.6;
  }

  .login-page .form-label {
    margin-bottom: 8px;
    color: #222;
    font-size: 14px;
    font-weight: 600;
  }

  .login-page .form-control {
    min-height: 51px;
    padding: 12px 14px;
    border: 1px solid #b0b0b0;
    border-radius: 10px;
    color: #222;
    background: #fff;
    font-size: 15px;
    box-shadow: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .login-page .form-control::placeholder {
    color: #999;
  }

  .login-page .form-control:focus {
    border-color: #222;
    box-shadow: 0 0 0 2px rgba(34, 34, 34, 0.08);
  }

  .login-field {
    margin-bottom: 20px;
  }

  .login-options {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin: 3px 0 24px;
    font-size: 13px;
  }

  .login-options .form-check-label {
    color: #555;
  }

  .login-options .form-check-input {
    cursor: pointer;
  }

  .login-options .form-check-input:checked {
    background-color: #ff385c;
    border-color: #ff385c;
  }

  .login-link {
    color: #222;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .login-link:hover {
    color: #ff385c;
  }

  .login-submit {
    width: 100%;
    min-height: 52px;
    border: none;
    border-radius: 10px;
    background: linear-gradient(90deg, #e61e4d, #ff385c);
    color: #fff;
    font-size: 16px;
    font-weight: 700;
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .login-submit:hover {
    color: #fff;
    background: linear-gradient(90deg, #d91445, #e61e4d);
    box-shadow: 0 5px 14px rgba(255, 56, 92, 0.22);
    transform: translateY(-1px);
  }

  .login-submit:active {
    transform: scale(0.99);
  }

  .login-divider {
    display: flex;
    align-items: center;
    gap: 13px;
    margin: 25px 0;
    color: #717171;
    font-size: 12px;
  }

  .login-divider::before,
  .login-divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background: #e5e5e5;
  }

  .login-footer {
    margin: 0;
    color: #555;
    text-align: center;
    font-size: 14px;
    line-height: 1.7;
  }

  .login-security {
    margin-top: 25px;
    padding-top: 20px;
    border-top: 1px solid #eee;
    color: #717171;
    font-size: 12px;
    line-height: 1.6;
    text-align: center;
  }

  .login-security i {
    margin-right: 5px;
    color: #008a70;
  }

  @media (max-width: 480px) {
    .login-page {
      min-height: auto;
      align-items: flex-start;
      padding: 28px 14px;
    }

    .login-card {
      padding: 25px 21px;
      border-radius: 16px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    }

    .login-title {
      font-size: 25px;
    }

    .login-brand {
      margin-bottom: 20px;
    }
  }
</style>

<div class="login-page">
  <div class="login-card">

    <div class="login-brand">
      <i class="fa-brands fa-airbnb" aria-hidden="true"></i>
    </div>

    <h1 class="login-title">Welcome back</h1>
    <p class="login-subtitle">
      Log in to discover stays, plan your next trip, and manage your listings.
    </p>

    <form action="/login" method="POST" class="needs-validation" novalidate>

      <div class="login-field">
        <label for="username" class="form-label">Username</label>
        <input
          name="username"
          id="username"
          type="text"
          class="form-control"
          placeholder="Enter your username"
          autocomplete="username"
          required
        >
        <div class="invalid-feedback">
          Please enter your username.
        </div>
      </div>

      <div class="login-field">
        <label for="password" class="form-label">Password</label>
        <input
          name="password"
          id="password"
          type="password"
          class="form-control"
          placeholder="Enter your password"
          autocomplete="current-password"
          required
        >
        <div class="invalid-feedback">
          Please enter your password.
        </div>
      </div>

      <div class="login-options">
        <div class="form-check">
          <input
            class="form-check-input"
            type="checkbox"
            id="remember"
          >
          <label class="form-check-label" for="remember">
            Remember me
          </label>
        </div>

        <a href="/signup" class="login-link">Create account</a>
      </div>

      <button type="submit" class="btn login-submit">
        Log in
      </button>

    </form>

    <div class="login-divider">New to our community?</div>

    <p class="login-footer">
      Don't have an account?
      <a href="/signup" class="login-link">Sign up</a>
      to start exploring unique places to stay.
    </p>

    <div class="login-security">
      <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
      Your account information is handled through your site's login system.
    </div>

  </div>
</div>

<script>
  (() => {
    "use strict";

    const forms = document.querySelectorAll(".needs-validation");

    Array.from(forms).forEach((form) => {
      form.addEventListener("submit", (event) => {
        if (!form.checkValidity()) {
          event.preventDefault();
          event.stopPropagation();
        }

        form.classList.add("was-validated");
      });
    });
  })();
</script>
