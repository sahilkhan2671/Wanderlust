<% layout("/layouts/boilerplate") %>

<style>
  .signup-page {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 16px;
    background: #fff;
  }

  .signup-card {
    width: 100%;
    max-width: 470px;
    padding: 36px;
    background: #fff;
    border: 1px solid #ebebeb;
    border-radius: 22px;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
  }

  .signup-brand {
    text-align: center;
    margin-bottom: 14px;
    color: #ff385c;
    font-size: 38px;
  }

  .signup-title {
    font-size: 29px;
    font-weight: 700;
    text-align: center;
    color: #222;
    margin-bottom: 8px;
  }

  .signup-subtitle {
    text-align: center;
    color: #717171;
    font-size: 14px;
    margin-bottom: 28px;
    line-height: 1.6;
  }

  .signup-card .form-label {
    font-weight: 600;
    color: #333;
    font-size: 14px;
    margin-bottom: 8px;
  }

  .signup-card .form-control {
    min-height: 49px;
    border: 1px solid #b0b0b0;
    border-radius: 10px;
    padding: 12px 14px;
    font-size: 15px;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .signup-card .form-control:focus {
    border-color: #ff385c;
    box-shadow: 0 0 0 3px rgba(255, 56, 92, 0.12);
  }

  .signup-submit {
    width: 100%;
    min-height: 49px;
    margin-top: 12px;
    border: none;
    border-radius: 10px;
    color: #fff;
    font-weight: 700;
    font-size: 16px;
    background: linear-gradient(90deg, #ff385c, #e61e4d);
    transition: transform 0.2s, box-shadow 0.2s;
  }

  .signup-submit:hover {
    color: #fff;
    transform: translateY(-1px);
    box-shadow: 0 5px 15px rgba(230, 30, 77, 0.25);
  }

  .signup-divider {
    display: flex;
    align-items: center;
    gap: 14px;
    color: #999;
    font-size: 12px;
    margin: 24px 0;
    white-space: nowrap;
  }

  .signup-divider::before,
  .signup-divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background: #e5e5e5;
  }

  .signup-login {
    text-align: center;
    font-size: 14px;
    color: #717171;
    margin-bottom: 0;
  }

  .signup-login a {
    color: #e61e4d;
    font-weight: 700;
    text-decoration: none;
  }

  .signup-login a:hover {
    text-decoration: underline;
  }

  .signup-terms {
    text-align: center;
    font-size: 12px;
    color: #858585;
    line-height: 1.6;
    margin-top: 22px;
    margin-bottom: 0;
  }

  .signup-terms a {
    color: #717171;
    text-decoration: underline;
  }

  @media (max-width: 576px) {
    .signup-page {
      min-height: auto;
      padding: 28px 12px;
    }

    .signup-card {
      padding: 28px 22px;
      border-radius: 16px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    }

    .signup-title {
      font-size: 25px;
    }
  }
</style>

<div class="signup-page">
  <div class="signup-card">

    <div class="signup-brand">
      <i class="fa-brands fa-airbnb" aria-hidden="true"></i>
    </div>

    <h1 class="signup-title">Join WanderLust</h1>

    <p class="signup-subtitle">
      Create an account and start exploring amazing stays.
    </p>

    <form
      action="/signup"
      method="POST"
      class="needs-validation"
      novalidate
    >

      <div class="mb-3">
        <label for="username" class="form-label">
          Username
        </label>

        <input
          name="username"
          id="username"
          type="text"
          class="form-control"
          placeholder="Choose a username"
          autocomplete="username"
          minlength="3"
          required
        >

        <div class="invalid-feedback">
          Please enter a username with at least 3 characters.
        </div>
      </div>

      <div class="mb-3">
        <label for="email" class="form-label">
          Email address
        </label>

        <input
          name="email"
          id="email"
          type="email"
          class="form-control"
          placeholder="you@example.com"
          autocomplete="email"
          required
        >

        <div class="invalid-feedback">
          Please enter a valid email address.
        </div>
      </div>

      <div class="mb-3">
        <label for="password" class="form-label">
          Password
        </label>

        <input
          name="password"
          id="password"
          type="password"
          class="form-control"
          placeholder="Create a password"
          autocomplete="new-password"
          minlength="8"
          required
        >

        <div class="invalid-feedback">
          Your password must be at least 8 characters long.
        </div>
      </div>

      <button type="submit" class="btn signup-submit">
        Create account
      </button>

    </form>

    <div class="signup-divider">
      ALREADY A MEMBER?
    </div>

    <p class="signup-login">
      Have an account?
      <a href="/login">Log in</a>
    </p>

    <p class="signup-terms">
      By signing up, you agree to our terms and privacy policy.
    </p>

  </div>
</div>

<script>
  (() => {
    const forms = document.querySelectorAll(".needs-validation");

    Array.from(forms).forEach((form) => {
      form.addEventListener("submit", (event) => {
        if (!form.checkValidity()) {
          event.preventDefault();
          event.stopPropagation();
        }

        form.classList.add("was-validated");
      });
    });
  })();
</script>